<Application x:Class="AiUsageWidget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#202938" />
        <SolidColorBrush x:Key="PanelBackground" Color="#16202D" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F4F7FB" />
        <SolidColorBrush x:Key="SecondaryText" Color="#AAB7C8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#67E8F9" />
        <SolidColorBrush x:Key="TrackBrush" Color="#334155" />
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#273449" />
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="BorderBrush" Value="#4B607A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#334155" />
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="BorderBrush" Value="#4B607A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </Application.Resources>
</Application>
