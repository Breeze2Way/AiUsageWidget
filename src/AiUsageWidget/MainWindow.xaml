<Window x:Class="AiUsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 用量悬浮球"
        Width="68"
        Height="68"
        MinWidth="68"
        MinHeight="68"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#E60B1728" />
            <Setter Property="Foreground" Value="#F5FAFF" />
            <Setter Property="BorderBrush" Value="#8059C7FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="ToolTipService.HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                                                  ShadowDepth="0"
                                                  Opacity="0.65"
                                                  Color="#3AB8FF" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu MinWidth="170"
                     Padding="4"
                     FontSize="13"
                     HasDropShadow="True">
            <MenuItem x:Name="SettingsMenuItem" Header="设置" Click="Settings_Click" Padding="10,6" />
            <Separator />
            <MenuItem x:Name="OfficialUsageMenuItem" Header="打开 Antigravity" Click="OfficialUsage_Click" Padding="10,6" />
            <MenuItem x:Name="CodexUsageMenuItem" Header="打开 Codex 用量" Click="CodexUsage_Click" Padding="10,6" />
            <MenuItem x:Name="LanguageMenuItem" Header="English" Click="Language_Click" Padding="10,6" />
            <MenuItem x:Name="ExitMenuItem" Header="退出" Click="Exit_Click" Padding="10,6" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="Card"
            Background="Transparent"
            BorderThickness="0"
            Padding="0">
        <Grid>
            <Grid x:Name="DashboardPanel">
            <Grid x:Name="WaterBallHost"
                      Background="Transparent"
                      MouseLeftButtonDown="Ball_MouseLeftButtonDown"
                      ToolTipService.InitialShowDelay="150"
                      ToolTipService.ShowDuration="60000"
                      ToolTipService.BetweenShowDelay="100" />
            </Grid>

            <Border x:Name="SettingsPanel"
                    Visibility="Collapsed"
                    Margin="10"
                    Padding="18"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="154" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="168" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Cursor="SizeAll"
                          MouseLeftButtonDown="SettingsHeader_MouseLeftButtonDown">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SettingsTitleText"
                                       Text="小工具设置"
                                       Foreground="#0F172A"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="SettingsSubtitleText"
                                       Text="调整数据刷新与外圈显示样式"
                                       Margin="0,3,0,0"
                                       Foreground="#64748B"
                                       FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="DataRefreshSectionText"
                               Grid.Row="1"
                               Text="数据与刷新"
                               Foreground="#0E7490"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="42" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="WeeklyBudgetLabel"
                                   Text="Codex 周预算（token）"
                                   Foreground="#334155"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="WeeklyBudgetBox"
                                 Grid.Column="1"
                                 Style="{StaticResource SettingsTextBoxStyle}"
                                 ToolTip="留空则不启用本地周 token 预算" />
                        <TextBlock x:Name="RefreshIntervalLabel"
                                   Grid.Row="1"
                                   Text="刷新间隔（秒）"
                                   Foreground="#334155"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="RefreshSecondsBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Style="{StaticResource SettingsTextBoxStyle}"
                                 ToolTip="官方用量查询间隔，范围 10–600 秒" />
                        <TextBlock x:Name="ProviderSelectionLabel"
                                   Grid.Row="2"
                                   Text="显示来源"
                                   Foreground="#334155"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Row="2" Grid.Column="1"
                                    Orientation="Horizontal"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                            <CheckBox x:Name="ShowAntigravityBox"
                                      Content="Antigravity"
                                      Foreground="#334155"
                                      Margin="0,0,22,0"
                                      VerticalAlignment="Center" />
                            <CheckBox x:Name="ShowCodexBox"
                                      Content="Codex"
                                      Foreground="#334155"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="OpacityLabel"
                                   Grid.Row="3"
                                   Text="窗口不透明度"
                                   Foreground="#334155"
                                   VerticalAlignment="Center" />
                        <Grid Grid.Row="3" Grid.Column="1" Margin="8,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="54" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="OpacitySlider"
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Minimum="45"
                                    Maximum="100"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="OpacitySlider_ValueChanged" />
                            <Border Grid.Column="1"
                                    Height="28"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <TextBlock x:Name="OpacityValueText"
                                           Text="92%"
                                           Foreground="#0F766E"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>

                    <TextBlock x:Name="RingStyleSectionText"
                               Grid.Row="4"
                               Text="外圈样式"
                               Foreground="#0E7490"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Grid Grid.Row="5" Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RingModeLabel"
                                   Text="颜色模式"
                                   Foreground="#334155"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="WeeklyRingModeBox"
                                  Grid.Column="1"
                                  Style="{StaticResource SettingsComboBoxStyle}"
                                  SelectionChanged="WeeklyRingMode_SelectionChanged">
                            <ComboBoxItem x:Name="SolidModeItem" Content="纯色" />
                            <ComboBoxItem x:Name="GradientModeItem" Content="渐变色" />
                        </ComboBox>
                        <TextBlock x:Name="StartColorLabel"
                                   Grid.Row="1"
                                   Text="起始颜色"
                                   Foreground="#334155"
                                   VerticalAlignment="Center" />
                        <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WeeklyRingStartColorBox"
                                     Style="{StaticResource SettingsTextBoxStyle}"
                                     TextChanged="RingColor_TextChanged" />
                            <Border x:Name="WeeklyRingStartPreview"
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Margin="6,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Cursor="Hand"
                                    ToolTip="点击色块选择颜色"
                                    MouseLeftButtonDown="PickStartColorPreview_MouseLeftButtonDown" />
                        </Grid>
                        <TextBlock x:Name="EndColorLabel"
                                   Grid.Row="2"
                                   Text="结束颜色"
                                   Foreground="#334155"
                                   VerticalAlignment="Center" />
                        <Grid Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WeeklyRingEndColorBox"
                                     Style="{StaticResource SettingsTextBoxStyle}"
                                     TextChanged="RingColor_TextChanged" />
                            <Border x:Name="WeeklyRingEndPreview"
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Margin="6,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Cursor="Hand"
                                    ToolTip="点击色块选择颜色"
                                    MouseLeftButtonDown="PickEndColorPreview_MouseLeftButtonDown" />
                        </Grid>
                        <TextBlock x:Name="TrackColorLabel"
                                   Grid.Row="3"
                                   Text="底色"
                                   Foreground="#334155"
                                   VerticalAlignment="Center" />
                        <Grid Grid.Row="3" Grid.Column="1" Margin="8,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WeeklyRingTrackColorBox"
                                     Style="{StaticResource SettingsTextBoxStyle}"
                                     TextChanged="RingColor_TextChanged" />
                            <Border x:Name="WeeklyRingTrackPreview"
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Margin="6,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Cursor="Hand"
                                    ToolTip="点击色块选择颜色"
                                    MouseLeftButtonDown="PickTrackColorPreview_MouseLeftButtonDown" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="6" Margin="0,4,0,0">
                        <TextBlock x:Name="ColorHintText"
                                   Text="支持 #RRGGBB，例如 #58B7E8；纯色模式只使用起始颜色。"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <CheckBox x:Name="TopmostBox"
                                      Content="窗口置顶"
                                      Foreground="#334155"
                                      Margin="0,0,18,0"
                                      VerticalAlignment="Center" />
                            <CheckBox x:Name="AutoStartBox"
                                      Content="开机启动"
                                      Foreground="#334155"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="7"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom">
                        <Button x:Name="CancelButton"
                                Content="取消"
                                Click="SettingsCancel_Click"
                                Style="{StaticResource SettingsButtonStyle}" />
                        <Button x:Name="SaveButton"
                                Content="保存设置"
                                Click="SettingsSave_Click"
                                Style="{StaticResource SettingsButtonStyle}"
                                Margin="10,0,0,0"
                                Foreground="White"
                                Background="#0E7490"
                                BorderBrush="#0E7490" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
